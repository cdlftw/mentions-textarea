{
	"name": "mentions-textarea",
	"version": "1.0.2",
	"description": "A React textarea component with @mention functionality and autosize",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.es.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"react",
		"textarea",
		"mentions",
		"autocomplete",
		"autosize",
		"typescript"
	],
	"author": "Craig Lindley",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cdlftw/mentions-textarea.git"
	},
	"homepage": "https://github.com/cdlftw/mentions-textarea#readme",
	"bugs": {
		"url": "https://github.com/cdlftw/mentions-textarea/issues"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.lib.json && vite build",
		"build:lib": "tsc -p tsconfig.lib.json && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"prepublishOnly": "npm run build:lib"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"dependencies": {
		"react-textarea-autosize": "^8.5.9"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^24.6.0",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.4",
		"eslint": "^9.36.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.22",
		"globals": "^16.4.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tailwindcss": "^4.1.14",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.1.7"
	}
}
