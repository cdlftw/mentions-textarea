{
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"allowImportingTsExtensions": false,
		"verbatimModuleSyntax": false
	},
	"include": ["src/**/*"],
	"exclude": [
		"src/**/*.test.*",
		"src/**/*.spec.*",
		"src/main.tsx",
		"src/App.tsx"
	]
}
